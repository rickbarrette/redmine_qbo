<%# QuickBooks status badges: the estimate page's header and the estimate lists (customer and vehicle pages) %>
<style>
  .qbo-estimate-status { display: inline-block; font-size: .6em; font-weight: 600; vertical-align: middle; padding: 2px 8px; border-radius: 10px;
    background: #eceef1; color: #393a3d; margin-left: 6px; }
  .qbo-estimate-status-sent { background: #e6f4e4; color: #108000; }
  .qbo-estimate-status-accepted { background: #e6f4e4; color: #108000; }
  .qbo-estimate-status-closed, .qbo-estimate-status-converted { background: #e8eefa; color: #0d47a1; }
  .qbo-estimate-status-rejected { background: #fdecea; color: #b71c1c; }
  .qbo-estimate-list .qbo-estimate-status { font-size: .8em; padding: 1px 7px; margin-left: 4px; }
  /* Invoices (RedmineQboBilling::InvoiceStatus) */
  .qbo-invoice-status-paid { background: #e6f4e4; color: #108000; }
  .qbo-invoice-status-partial { background: #fff4d6; color: #8a6100; }
  .qbo-invoice-status-overdue { background: #fdecea; color: #b71c1c; }
  .qbo-invoice-status-open { background: #e8eefa; color: #0d47a1; }
  .qbo-invoice-status-voided { background: #eceef1; color: #6b6c72; text-decoration: line-through; }
  .qbo-invoice-list .qbo-estimate-status { font-size: .8em; padding: 1px 7px; margin-left: 4px; }
</style>
