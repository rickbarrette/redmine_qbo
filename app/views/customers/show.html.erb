<div class="contextual">
  <%# New issue for this customer; picks up the estimate / vehicle ticked on this page %>
  <%= link_to sprite_icon('add', l(:label_new_issue)), new_issue_path(issue: { customer_id: @customer.id }),
              id: 'dynamic-new-issue-link', class: 'icon icon-add', target: :_blank %>
  <%# Plugins add their customer actions here (e.g. redmine_qbo_calendar's Add appointment) %>
  <%= call_hook :view_customers_show_contextual, { customer: @customer } %>
  <%# Estimates, invoices and payments are handled here, each shown to users with its permission. The customer's
      name below links to their QuickBooks account page as a fallback. %>
  <% if RedmineQboBilling.writer? %>
    <%= render partial: 'qbo_estimates/customer_link', locals: { customer: @customer } %>
  <% end %>
  <% if RedmineQboBilling.invoice_writer? %>
    <%= render partial: 'qbo_invoices/customer_link', locals: { customer: @customer } %>
  <% end %>
  <% if RedmineQboBilling.payment_viewer? %>
    <%= link_to sprite_icon('list', l(:label_payments)), qbo_payments_path(customer_id: @customer.id), class: 'icon icon-list' %>
  <% end %>
  <% if RedmineQboBilling.payment_receiver? %>
    <%= link_to sprite_icon('add', l(:button_receive_payment)), new_qbo_payment_path(customer_id: @customer.id), class: 'icon icon-add' %>
  <% end %>
  <% if User.current.allowed_to?(:edit_customers, nil, global: true) %>
    <%= link_to sprite_icon('edit', l(:button_edit)), edit_customer_path(@customer),
                class: 'icon icon-edit', accesskey: accesskey(:edit) %>
  <% end %>
</div>

<h2><%=t(:field_customer)%> #<%= @customer.id %> - <%= link_to @customer.to_s, "https://#{RedmineQbo.sandbox_mode? ? "sandbox" : "app"}.qbo.intuit.com/app/customerdetail?nameId=#{@customer.id}", target: :_blank %> </h2>
  <div class="issue">

    <div class="splitcontent">

      <div class="splitcontentleft">

        <h4><%=t(:label_details)%>:</h4>

        <!-- Customer Info -->

        <%= render partial: 'customers/details', locals: {customer: @customer} %>


        <!-- QBO Info -->

        <div class="splitcontent">
          <div class="splitcontentleft">
            <h4><%=t(:estimates)%>:</h4>
            <%= render partial: 'estimates/list', locals: {estimates: @customer.estimates} %>
          </div>

          <div class="splitcontentleft">
            <h4><%=t(:label_invoices)%>:</h4>
            <%= render partial: 'invoices/list', locals: {invoices: @customer.invoices} %>
          </div>
        </div>

      </div>
        
      <div class="splitcontentleft">
        <%= call_hook :show_customer_view_right, {customer: @customer} %>
      </div>
    </div>

  </div>

<br/>
<h3><%=@open_issues.count%> <%=t(:label_open_issues)%> - <%=@hours.round(1)%> <%=t(:label_hours)%></h3>
<%= render partial: 'issues/list_simple', locals: {issues: @open_issues.open} %>

<h3><%=@closed_issues.count%> <%=t(:label_closed_issues)%> - <%= @closed_hours.round(1)%> <%=t(:label_hours)%></h3>
<%= render partial: 'issues/list_simple', locals: {issues: @closed_issues} %>

<%= render partial: 'customers/new_issue_link_script' %>
