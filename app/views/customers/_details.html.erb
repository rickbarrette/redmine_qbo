<%# Phone numbers as (401) 555-0101, left blank when the customer has none %>
<% phone = ->(number) { digits = number.to_s.gsub(/\D/, ''); digits.present? ? number_to_phone(digits.to_i, area_code: true) : '' } %>
<table>
  <tbody>

    <tr>
      <th><%= t(:label_name) %></th>
      <td><%= customer.name %></td>
    </tr>

    <tr>
      <th><%= t(:label_email) %></th>
      <td><%= customer.email %></td>
    </tr>
    
    <tr>
      <th><%= t(:label_primary_phone) %></th>
      <td><%= phone.call(customer&.primary_phone) %></td>
    </tr>
    
    <tr>
      <th><%= t(:label_mobile_phone) %></th>
      <td><%= phone.call(customer&.mobile_phone) %></td>
    </tr>
    
    <tr>
      <th><%= t(:label_billing_address) %></th>
      <td><pre><%= RedmineQboBilling::EstimateWriter.format_address(customer.billing_address) %></pre></td>
    </tr>
    
    <tr>
      <th><%= t(:label_shipping_address) %></th>
      <td><pre><%= RedmineQboBilling::EstimateWriter.format_address(customer.shipping_address) %></pre></td>
    </tr>
    
    <tr>
      <th><%= t(:label_account_balance) %></th>
      <td><%= number_to_currency(customer.balance || 0) %></td>
    </tr>
    
    <% if customer.notes.present? %>
      <tr>
        <th colspan="2"><h4><%= t(:field_notes) %></h4></th>
      </tr>

      <tr>
        <td colspan="2">
          <div class="wiki">
            <%= textilizable(customer, :notes) %>
          </div>
        </td>
      </tr>
    <% end %>

  </tbody>
</table> 
<br/>
<br/>