<%#
  Adds what's ticked on the customer page to the "New issue" link (#dynamic-new-issue-link in the contextual
  area). Any checkbox with data-new-issue-param="issue[field]" takes part, one ticked per field: this plugin's
  estimates (issue[estimate_id]), and other plugins' lists (e.g. redmine_qbo_vehicles' issue[vehicle_id]).
%>
<script>
  function newIssueParamBoxes(param) {
    return Array.prototype.filter.call(document.querySelectorAll('input[data-new-issue-param]'), function (cb) {
      return !param || cb.getAttribute('data-new-issue-param') === param;
    });
  }

  // One box per field: ticking one unticks the others for the same field
  document.addEventListener('change', function (event) {
    var box = event.target;
    if (!box.matches || !box.matches('input[data-new-issue-param]')) return;
    if (box.checked) {
      newIssueParamBoxes(box.getAttribute('data-new-issue-param')).forEach(function (cb) {
        if (cb !== box) cb.checked = false;
      });
    }
    updateLink();
  });

  function updateLink() {
    var link = document.getElementById('dynamic-new-issue-link');
    if (!link) return;

    // Cache the pristine base URL on first run
    if (!link.dataset.baseUrl) link.dataset.baseUrl = link.getAttribute('href');
    var url = new URL(link.dataset.baseUrl, window.location.origin);

    newIssueParamBoxes().forEach(function (cb) {
      var param = cb.getAttribute('data-new-issue-param');
      var ticked = newIssueParamBoxes(param).filter(function (b) { return b.checked; })[0];
      if (ticked) {
        url.searchParams.set(param, ticked.value);
      } else {
        url.searchParams.delete(param);
      }
    });

    link.setAttribute('href', url.toString());
  }
</script>
