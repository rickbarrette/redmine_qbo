<%#
  Adds what's ticked on the customer page to its links: "New issue" (#dynamic-new-issue-link in the contextual area)
  and redmine_qbo_calendar's "Add appointment" (#appointment_link). A checkbox takes part with
  data-new-issue-param="issue[field]" (New issue) and data-appointment-param="field" (Add appointment); one is
  ticked per field: this plugin's estimates (estimate_id), and other plugins' lists (e.g. redmine_qbo_vehicles'
  vehicle_id).
%>
<script>
  (function () {
    var LINKS = [['dynamic-new-issue-link', 'data-new-issue-param'], ['appointment_link', 'data-appointment-param']];
    var ANY = 'input[data-new-issue-param], input[data-appointment-param]';

    function boxes(attr, param) {
      return Array.prototype.filter.call(document.querySelectorAll('input[' + attr + ']'), function (cb) {
        return !param || cb.getAttribute(attr) === param;
      });
    }

    // Boxes for the same field (the same estimate list, the same vehicle list)
    function sameField(box) {
      for (var i = 0; i < LINKS.length; i++) {
        var attr = LINKS[i][1], param = box.getAttribute(attr);
        if (param) return boxes(attr, param);
      }
      return [box];
    }

    function updateLinks() {
      LINKS.forEach(function (pair) {
        var link = document.getElementById(pair[0]);
        if (!link) return;
        // Cache the pristine base URL on first run
        if (!link.dataset.baseUrl) link.dataset.baseUrl = link.getAttribute('href');
        var url = new URL(link.dataset.baseUrl, window.location.origin);
        boxes(pair[1]).forEach(function (cb) {
          var param = cb.getAttribute(pair[1]);
          var ticked = boxes(pair[1], param).filter(function (b) { return b.checked; })[0];
          if (ticked) {
            url.searchParams.set(param, ticked.value);
          } else {
            url.searchParams.delete(param);
          }
        });
        link.setAttribute('href', url.toString());
      });
    }

    // One box per field: ticking one unticks the others for the same field
    document.addEventListener('change', function (event) {
      var box = event.target;
      if (!box.matches || !box.matches(ANY)) return;
      if (box.checked) {
        sameField(box).forEach(function (cb) { if (cb !== box) cb.checked = false; });
      }
      updateLinks();
    });
  })();
</script>
